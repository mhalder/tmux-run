#compdef tmux-run

# Subcommands: list show wait clean rm skill completion __complete
# Top-level options: --help --version

_tmux-run() {
    local -a sessions

    if (( CURRENT == 2 )); then
        compadd -- list show wait clean rm skill completion __complete --help --version
        return
    fi

    case "${words[2]}" in
        list)
            compadd -- --json
            ;;
        show)
            if [[ "${words[CURRENT-1]}" == "--lines" ]]; then
                return
            fi
            compadd -- --lines --json
            sessions=("${(@f)$(tmux-run __complete sessions "${words[CURRENT]}" 2>/dev/null)}")
            compadd -a sessions
            ;;
        wait)
            if [[ "${words[CURRENT-1]}" == "--timeout" ]]; then
                return
            fi
            compadd -- --timeout
            sessions=("${(@f)$(tmux-run __complete sessions "${words[CURRENT]}" 2>/dev/null)}")
            compadd -a sessions
            ;;
        clean)
            if [[ "${words[CURRENT-1]}" == "--older-than" ]]; then
                return
            fi
            compadd -- --older-than --dry-run
            ;;
        rm)
            compadd -- --force
            sessions=("${(@f)$(tmux-run __complete sessions "${words[CURRENT]}" 2>/dev/null)}")
            compadd -a sessions
            ;;
        skill)
            compadd -- --install --check
            ;;
        completion)
            if (( CURRENT == 3 )); then
                compadd -- bash zsh fish
            else
                compadd -- --install --check
            fi
            ;;
        __complete)
            compadd -- sessions
            ;;
        *)
            compadd -- list show wait clean rm skill completion __complete --help --version
            ;;
    esac
}
